# Secrets. .env.example is committed; .env never is.
.env
*.env.local
backup/

# Agent configuration. Not part of Maanak: nothing under api/, web/, docs/ or scripts/
# reads it and it is not in the release archive. .kiro/settings/mcp.json also holds a
# personal access token in plain text, so the whole directory stays local.
.kiro/

# Release output
dist/

# Test output. Curated copies for the README live in docs/screenshots/.
api/screenshots/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and scratch files
*.log
_*.sh
_*.py
_*.txt
_*.md
test_output.txt
full_test.txt
sbom.json

# Generated reports and personal preparation notes. Local deliverables, not project source.
docs/*.docx
hackathon-*.md
hackathon-*.docx
