# Secrets. .env.example is committed; .env never is.
.env
*.env.local
backup/

# Local editor and assistant configuration. Not part of Maanak: nothing under api/, web/,
# docs/ or scripts/ reads it, and it is not in the release archive. It can also hold
# machine-local credentials, so the whole directory stays out of the repository.
.kiro/

# Release output
dist/

# Test output. Curated copies for the README live in docs/screenshots/.
api/screenshots/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and scratch files
*.log
_*.sh
_*.py
_*.txt
_*.md
# Local verification tooling and the Open Food Facts corpus it measures against. Kept out
# of /tmp so a reboot does not lose it, and out of the repository because it is 7 MB of
# other people's photographs and a runner that hardcodes local paths.
_tools/
test_output.txt
full_test.txt
sbom.json

# Generated deliverables and personal preparation notes. Local output, not project
# source: the presentation template belongs to the hackathon organiser, the deck and the
# Word report are rebuilt from docs/ when they are needed, and none of the three is read
# by anything under api/, web/ or scripts/. docs/PROJECT_REPORT.md is the committed form
# of the report, because markdown is what the rest of docs/ is written in and the prose
# gate can read it.
docs/*.docx
docs/*.pptx
docs/*.pdf
hackathon-*.md
hackathon-*.docx
finaltouch.md
